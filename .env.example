# Copy to .env and fill in. `npm run db:setup` creates the MySQL user + database
# named in DATABASE_URL (using the administrator login) and applies db/migrations.
# Works with MySQL 8.0.16+ and MariaDB 10.4+ (e.g. XAMPP). Set the server's
# max_allowed_packet to 64M so records with photo attachments can be saved.

# MySQL administrator (e.g. root) — only used by `npm run db:setup`
MYSQL_ADMIN_URL=mysql://root:CHANGE_ME@localhost:3306

# The app's own database login. Use a limited account like this one (db:setup creates it
# and lets it reach only this database), never root: root could read every other database.
DATABASE_URL=mysql://learnex_app:CHANGE_ME@localhost:3306/hashil

# Optional: the database `npm run test:db` uses (its name must end in _test; the
# tests wipe it). Defaults to DATABASE_URL + "_test". Set it to a local server
# when DATABASE_URL points at a hosted database.
# TEST_DATABASE_URL=mysql://learnex_app:CHANGE_ME@localhost:3306/hashil_test

# One-time code asked for when creating the first (owner) account. Use a long random value.
AUTH_SETUP_CODE=CHANGE_ME

# Optional: session lifetime (defaults shown)
# AUTH_SESSION_IDLE_HOURS=12
# AUTH_SESSION_MAX_DAYS=7

# Optional: how long a one-time password handed out by an administrator works (hours, default 72).
# AUTH_TEMP_PASSWORD_HOURS=72

# Optional: lets people switch on two-step sign-in (authenticator app). 16+ random characters;
# their authenticator secrets are stored encrypted with it, so never change or lose it.
# AUTH_MFA_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Needed by `npm run db:backup`: backups are encrypted with it (12+ characters). Keep a copy in a
# password manager, not next to the backup files.
# BACKUP_PASSPHRASE=CHANGE_ME_TO_A_LONG_PASSPHRASE

# Optional: limits on sign-in attempts (defaults shown; 0 switches a limit off).
# One client may try this many times per window.
# AUTH_RATE_LIMIT=20
# AUTH_RATE_WINDOW_SECONDS=60

# Optional: behind a reverse proxy that sets X-Forwarded-For (see "Security settings" in the README),
# how many proxies are in front of the app. Leave it out when browsers connect to the app directly.
# TRUST_PROXY_HOPS=1

# Optional: once the HTTPS reverse proxy is in place, refuse sign-in and password changes over plain HTTP.
# AUTH_REQUIRE_HTTPS=1

# Optional, for a database reached over the internet (e.g. the app on Vercel, MySQL at alwaysdata):
# DATABASE_SSL=1          encrypt the connection and check the server's certificate (off by default)
# DATABASE_POOL_SIZE=3    connections per server instance (default 10); lower it on serverless hosts

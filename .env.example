# Copy to .env and fill in. `npm run db:setup` creates the role + database
# named in DATABASE_URL (using the superuser login) and applies db/migrations.

# PostgreSQL superuser — only used by `npm run db:setup`
POSTGRES_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres

# The app's own database login
DATABASE_URL=postgresql://learnex_app:CHANGE_ME@localhost:5432/hashil

# One-time code asked for when creating the first (owner) account. Use a long random value.
AUTH_SETUP_CODE=CHANGE_ME

# Optional: session lifetime (defaults shown)
# AUTH_SESSION_IDLE_HOURS=12
# AUTH_SESSION_MAX_DAYS=7
